(version 1)
# JLCPCB 4-layer, 1 oz, standard (no extra cost) limits
# https://jlcpcb.com/capabilities/pcb-capabilities

(rule "JLC PTH annular ring"
  (constraint annular_width (min 0.15))
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'"))

(rule "JLC pad hole to hole"
  (constraint hole_to_hole (min 0.45))
  (condition "A.Type == 'Pad' && B.Type == 'Pad'"))

(rule "JLC PTH to track"
  (constraint hole_clearance (min 0.28))
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type == 'Track'"))

(rule "JLC NPTH minimum"
  (constraint hole_size (min 0.5))
  (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'"))

(rule "JLC SMD pad to pad"
  (constraint clearance (min 0.15))
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD' && A.Net != B.Net"))

(rule "JLC inner layer PTH to copper"
  (layer inner)
  (constraint hole_clearance (min 0.3))
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'"))
